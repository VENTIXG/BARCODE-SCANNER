# Reverse proxy with automatic HTTPS (Let's Encrypt) for the domain in DOMAIN.
# DOMAIN=:80 serves plain HTTP only, for a closed office network (set COOKIE_SECURE=false then).
{$DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy app:4000 {
		# Server-sent events (live updates) must not be buffered.
		flush_interval -1
	}
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
