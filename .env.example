# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# Public address of the app. Use a real domain for HTTPS, or :80 for a LAN without a domain.
DOMAIN=ims.example.com
# Set to false only when DOMAIN=:80 (plain HTTP on the office network).
COOKIE_SECURE=true

# Long random string (e.g. `openssl rand -hex 48`). Changing it signs everyone out.
JWT_SECRET=

# Password of the PostgreSQL database (e.g. `openssl rand -hex 32`), set before the first start.
POSTGRES_PASSWORD=

# Development without Docker (npm run dev): leave empty for the built-in database in
# server/data/pgdata, or a PostgreSQL server: postgres://user:password@localhost:5432/ims
# DATABASE_URL=

# Password of the first administrator, used only when the database is created.
# Use at least 12 characters. After the first login, create personal accounts and
# keep this one for emergencies.
ADMIN_PASSWORD=

# Sessions last this many hours.
SESSION_HOURS=12

# Ports on the host (change when another service already uses 80/443).
HTTP_PORT=80
HTTPS_PORT=443

