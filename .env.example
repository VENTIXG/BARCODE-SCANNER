# Copy to .env (or set in your process manager). All values are optional.
PORT=4000
NODE_ENV=production
# Where the SQLite database, uploads and the generated JWT secret are stored
DATA_DIR=./server/data
# Set a long random value in production (otherwise one is generated into DATA_DIR)
JWT_SECRET=
# Session length in hours
SESSION_HOURS=12
# Set to true when the app is served over HTTPS (secure cookies)
COOKIE_SECURE=false
# Number of reverse proxies in front of the app (for correct client IPs in the audit log)
TRUST_PROXY=0
# Password for the initial admin account created on an empty database
ADMIN_PASSWORD=admin123
